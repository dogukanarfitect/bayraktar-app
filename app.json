        "backgroundColor": "#9F2F4D",
        "foregroundImage": "./assets/logo-bayraktar.png"
      },
      "package": "com.bayraktar.mobileportal",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
