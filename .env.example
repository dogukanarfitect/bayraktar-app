# BAYRA n8n webhook adresi. Gerçek değer yerel .env dosyasında tutulmalıdır.
EXPO_PUBLIC_BAYRA_WEBHOOK_URL=https://your-n8n-host.example/webhook/your-webhook-id

# İK asistanı n8n webhook adresi. Gerçek değer yerel .env dosyasında tutulmalıdır.
EXPO_PUBLIC_HR_WEBHOOK_URL=https://your-n8n-host.example/webhook/your-hr-webhook-id
